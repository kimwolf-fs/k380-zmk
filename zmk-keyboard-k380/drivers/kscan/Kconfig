DT_COMPAT_K380_KSCAN_NO_DIODE_MATRIX := k380,kscan-no-diode-matrix

if KSCAN

config K380_KSCAN_NO_DIODE_MATRIX
    bool
    default $(dt_compat_enabled,$(DT_COMPAT_K380_KSCAN_NO_DIODE_MATRIX))
    select ZMK_KSCAN_GPIO_DRIVER

if K380_KSCAN_NO_DIODE_MATRIX

config ZMK_KSCAN_MATRIX_WAIT_BEFORE_INPUTS
    int "Microseconds to wait before reading K380 matrix inputs"
    default 0
    help
      Delay after selecting a matrix row before reading the column inputs.
      K380 uses the common ZMK matrix wait symbol without enabling the
      standard GPIO matrix driver.

config ZMK_KSCAN_MATRIX_WAIT_BETWEEN_OUTPUTS
    int "Microseconds to wait between K380 matrix outputs"
    default 0
    help
      Delay after releasing one K380 matrix row before selecting the next row.
      This lets the previous output settle on boards where row transitions can
      otherwise leak into the next scan window.

endif # K380_KSCAN_NO_DIODE_MATRIX

config K380_MATRIX_DIAGNOSTICS_RTT
    bool "Emit K380 matrix events over RTT"
    depends on K380_KSCAN_NO_DIODE_MATRIX
    default n
    help
      Emit each K380 kscan press and release as a plain text RTT line with
      both matrix coordinates and the recorded physical key name:
      K380_MATRIX row=<row> col=<column> key=<key> state=<down|up>.

      This is a hardware bring-up diagnostic path. It must stay disabled in
      normal K380 firmware builds.

config K380_MATRIX_DIAGNOSTICS_RTT_HEARTBEAT
    bool "Emit K380 RTT diagnostic heartbeat"
    depends on K380_MATRIX_DIAGNOSTICS_RTT
    default n
    help
      Emit one RTT heartbeat line per second. This is useful for proving that
      the application thread scheduler is alive, but should stay disabled
      during per-key matrix validation to keep the log readable.

endif # KSCAN
