menu "K380 keyboard module"

rsource "drivers/kscan/Kconfig"

config K380_STATUS_INDICATOR
    bool "K380 WS2812B status indicator"
    default n
    select LED_STRIP
    help
      Enables the K380 status indicator policy for the four board WS2812B
      pixels.

config K380_BLE_SLOT_POLICY
    bool "K380 BLE slot policy"
    default n
    depends on ZMK_BLE
    select K380_STATUS_INDICATOR
    help
      Enables the K380 three-slot BLE policy and status indicator mapping.

config K380_BATTERY_POLICY
    bool "K380 VDDH battery policy"
    default n
    depends on ZMK_BATTERY_REPORTING
    select K380_STATUS_INDICATOR
    select K380_SOFT_OFF
    help
      Enables K380 VDDH moving-average battery policy and status mapping.

config K380_SOFT_OFF
    bool "K380 low-voltage soft-off handling"
    default n
    depends on ZMK_PM_SOFT_OFF
    select SETTINGS
    select K380_STATUS_INDICATOR
    help
      Saves a one-time low-voltage shutdown reason and enters ZMK soft-off.

config K380_BATTERY_POLICY_RUNTIME
    bool
    default y if K380_BATTERY_POLICY
    depends on K380_BATTERY_POLICY
    help
      Enables immediate K380 VDDH sampling on boot, wake, and USB state changes.

endmenu
