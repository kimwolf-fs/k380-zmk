menu "K380 keyboard module"

rsource "drivers/kscan/Kconfig"

config K380_STATUS_INDICATOR
    bool "K380 WS2812B status indicator"
    default n
    select LED_STRIP
    help
      Enables the K380 status indicator policy for the four board WS2812B
      pixels.

config K380_BLE_SLOT_POLICY
    bool "K380 BLE slot policy"
    default n
    depends on ZMK_BLE
    select K380_STATUS_INDICATOR
    help
      Enables the K380 three-slot BLE policy and status indicator mapping.

config K380_BATTERY_POLICY
    bool "K380 VDDH battery policy"
    default n
    depends on ZMK_BATTERY_REPORTING
    select K380_STATUS_INDICATOR
    select K380_SOFT_OFF
    help
      Enables K380 VDDH moving-average battery policy and status mapping.

config K380_SOFT_OFF
    bool "K380 low-voltage soft-off handling"
    default n
    depends on ZMK_PM_SOFT_OFF
    select SETTINGS
    select K380_STATUS_INDICATOR
    help
      Saves a one-time low-voltage shutdown reason and enters ZMK soft-off.

config K380_CONFIG_TOOL
    bool "K380 web configuration tool"
    default n
    select K380_DYNAMIC_CONFIG
    select K380_DYNAMIC_KEYMAP
    select K380_DYNAMIC_MACRO
    select K380_DYNAMIC_PRESET_SWITCH
    select K380_DYNAMIC_PROTOCOL
    select K380_DYNAMIC_TRANSPORT
    help
      Enables the K380 private USB CDC configuration protocol for runtime
      key remapping, presets, and macros without enabling ZMK Studio.

config K380_DYNAMIC_CONFIG
    bool "K380 runtime dynamic config"
    default n
    select SETTINGS

config K380_DYNAMIC_KEYMAP
    bool "K380 runtime dynamic keymap"
    default n
    depends on K380_DYNAMIC_CONFIG

config K380_DYNAMIC_MACRO
    bool "K380 runtime dynamic macro executor"
    default n
    depends on K380_DYNAMIC_CONFIG

config K380_DYNAMIC_PRESET_SWITCH
    bool "K380 runtime dynamic preset switch behavior"
    default n
    depends on K380_DYNAMIC_CONFIG

config K380_DYNAMIC_PROTOCOL
    bool "K380 private dynamic configuration protocol"
    default n
    depends on K380_DYNAMIC_CONFIG && K380_DYNAMIC_MACRO && K380_DYNAMIC_PRESET_SWITCH

config K380_DYNAMIC_TRANSPORT
    bool "K380 private dynamic configuration CDC transport"
    default n
    depends on K380_DYNAMIC_PROTOCOL
    select SERIAL
    select UART_INTERRUPT_DRIVEN
    help
      Uses the application-mode CDC UART chosen for the K380 configuration
      tool. This transport is independent from ZMK Studio.

config K380_BATTERY_POLICY_RUNTIME
    bool
    default y if K380_BATTERY_POLICY
    depends on K380_BATTERY_POLICY
    help
      Enables immediate K380 VDDH sampling on boot, wake, and USB state changes.

endmenu
